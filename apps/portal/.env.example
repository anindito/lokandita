# Portal — daftar variabel: KONTRAK.md §10. Nilai ditulis tanpa tanda kutip.
# Berkas ini juga menjadi daftar variabel wajib saat aplikasi mulai.
# {{…}} diisi oleh infra/buat-env.sh.
APP_URL=https://lokandita.com
CONTACT_EMAIL=lokanditax@gmail.com
PORTAL_URL=https://lokandita.com
LOKAKODE_URL=https://lokakode.lokandita.com
LOKAUJIAN_URL=https://lokaujian.lokandita.com
COOKIE_DOMAIN=.lokandita.com
DB_DSN=MySQLi://portal_app:{{DB_PASSWORD_PORTAL}}@mysql:3306/portal
IDENTITY_READER_DSN=MySQLi://identity_reader:{{DB_PASSWORD_IDENTITY_READER}}@mysql:3306/identity
REDIS_URL=redis://:{{REDIS_PASSWORD}}@redis:6379/2
AUTH_PUBLIC_URL=https://auth.lokandita.com
AUTH_LOGIN_URL=https://auth.lokandita.com/login
AUTH_INTERNAL_URL=http://auth-internal:8080
AUTH_SERVICE_TOKEN={{SERVICE_TOKEN_PORTAL}}
