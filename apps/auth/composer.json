{
    "name": "lokandita/app-auth",
    "description": "Lokandita — LokaAuth",
    "license": "proprietary",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/lokandita-auth",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.0",
        "codeigniter4/framework": "^4.7",
        "lokandita/auth": "*",
        "phpoffice/phpspreadsheet": "^5.0",
        "spomky-labs/otphp": "^11.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
