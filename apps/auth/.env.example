# LokaAuth — daftar variabel: KONTRAK.md §10. Nilai ditulis tanpa tanda kutip.
# Berkas ini juga menjadi daftar variabel wajib saat aplikasi mulai.
# {{…}} diisi oleh infra/buat-env.sh.
APP_URL=https://auth.lokandita.com
CONTACT_EMAIL=lokanditax@gmail.com
COOKIE_DOMAIN=.lokandita.com
ALLOWED_HOSTS=lokandita.com,www.lokandita.com,auth.lokandita.com,lokakode.lokandita.com
PORTAL_URL=https://lokandita.com
DB_DSN=MySQLi://auth_app:{{DB_PASSWORD_AUTH}}@mysql:3306/identity
REDIS_URL=redis://:{{REDIS_PASSWORD}}@redis:6379/1
SERVICE_TOKEN_PORTAL={{SERVICE_TOKEN_PORTAL}}
SERVICE_TOKEN_LOKAKODE={{SERVICE_TOKEN_LOKAKODE}}
MFA_ENCRYPTION_KEY={{ACAK}}
