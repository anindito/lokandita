# LokaUjian — daftar variabel: KONTRAK.md §10. Nilai ditulis tanpa tanda kutip.
# Berkas ini juga menjadi daftar variabel wajib saat aplikasi mulai.
# {{…}} diisi oleh infra/buat-env.sh.
APP_URL=https://lokaujian.lokandita.com
CONTACT_EMAIL=lokanditax@gmail.com
PORTAL_URL=https://lokandita.com
COOKIE_DOMAIN=.lokandita.com
DB_DSN=MySQLi://lokaujian_app:{{DB_PASSWORD_LOKAUJIAN}}@mysql:3306/lokaujian
IDENTITY_READER_DSN=MySQLi://identity_reader:{{DB_PASSWORD_IDENTITY_READER}}@mysql:3306/identity
# Kelas dan pendaftaran dibaca HANYA lewat lima view roster (KONTRAK.md §18), sebagai pengguna
# yang hanya bisa membaca view itu. Skema di ujung DSN ini adalah tempat view-nya berada
# (sekarang lokakode); nama skema itu tidak muncul di kode LokaUjian.
ROSTER_READER_DSN=MySQLi://roster_reader:{{DB_PASSWORD_ROSTER_READER}}@mysql:3306/lokakode
REDIS_URL=redis://:{{REDIS_PASSWORD}}@redis:6379/3
# Redis tempat antrean judge LokaKode berada (DB 0, KONTRAK.md §6). LokaUjian hanya MEMBACA
# panjang antreannya, untuk peringatan "server sedang sibuk" di halaman sesi dosen.
JUDGE_QUEUE_REDIS_URL=redis://:{{REDIS_PASSWORD}}@redis:6379/0
AUTH_PUBLIC_URL=https://auth.lokandita.com
AUTH_LOGIN_URL=https://auth.lokandita.com/login
AUTH_INTERNAL_URL=http://auth-internal:8080
AUTH_SERVICE_TOKEN={{SERVICE_TOKEN_LOKAUJIAN}}
# Safe Exam Browser (KONTRAK.md §8, §10, §23). Konfigurasi SEB LokaUjian per ujian, tersimpan
# terenkripsi dengan SEB_ENCRYPTION_KEY: rahasia milik LokaUjian sendiri, TIDAK BOLEH berubah
# selama ada konfigurasi (kalau berubah, setiap ujian harus dirotasi), dan ikut setiap backup.
SEB_ENCRYPTION_KEY={{ACAK}}
# enabled: mahasiswa hanya bisa mengerjakan ujian dari dalam SEB dengan berkas ujian itu.
# disabled: hanya untuk uji coba pemilik — tidak ada yang diperiksa dan halaman mahasiswa
# diberi pita merah MODE UJI.
SEB_ENFORCEMENT=enabled
