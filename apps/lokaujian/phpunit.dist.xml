<?xml version="1.0" encoding="UTF-8"?>
<!-- Dijalankan hanya lewat infra/tes.sh <app>, di dalam kontainer, terhadap skema *_test. -->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/codeigniter4/framework/system/Test/bootstrap.php"
    backupGlobals="false"
    beStrictAboutOutputDuringTests="true"
    colors="false"
    failOnRisky="true"
    failOnWarning="true"
    failOnSkipped="true"
    failOnIncomplete="true"
    cacheDirectory="writable/.phpunit.cache"
    defaultTestSuite="App"
>
    <testsuites>
        <testsuite name="App">
            <directory>./tests</directory>
            <!-- Uji beban punya suite sendiri dan hanya dijalankan infra/uji-beban.sh (KONTRAK.md §12). -->
            <exclude>./tests/Beban</exclude>
            <!-- Tes kontrak paket bersama dijalankan di setiap aplikasi klien (sejak tahap U1). -->
            <directory>./vendor/lokandita/auth/tests</directory>
        </testsuite>
        <testsuite name="Beban">
            <directory>./tests/Beban</directory>
        </testsuite>
    </testsuites>

    <php>
        <server name="CODEIGNITER_SCREAM_DEPRECATIONS" value="0"/>
        <const name="HOMEPATH" value="./"/>
        <const name="CONFIGPATH" value="./app/Config/"/>
        <const name="PUBLICPATH" value="./public/"/>
    </php>
</phpunit>
