# Judge worker — daftar variabel: KONTRAK.md §10. Nilai ditulis tanpa tanda kutip.
# Berkas ini juga menjadi daftar variabel wajib saat worker mulai.
# {{…}} diisi oleh infra/buat-env.sh. Worker berjalan di host, jadi MySQL dan
# Redis dicapai lewat 127.0.0.1 (KONTRAK.md §6).
DB_DSN=MySQLi://judge_worker:{{DB_PASSWORD_JUDGE}}@127.0.0.1:3306/lokakode
REDIS_URL=redis://:{{REDIS_PASSWORD}}@127.0.0.1:6379/0
JUDGE_CONCURRENCY=4
