#!/bin/sh
# "Kompilasi" untuk Python: hanya memeriksa sintaks, tidak menjalankan apa pun.
# Galat sintaks ditulis ke stderr dan kode keluar bukan nol.
exec python3 -c '
import sys
try:
    compile(open("/src/main.py", encoding="utf-8").read(), "main.py", "exec")
except (SyntaxError, ValueError, UnicodeDecodeError) as e:
    import traceback
    sys.stderr.write("".join(traceback.format_exception_only(type(e), e)))
    sys.exit(1)
'
